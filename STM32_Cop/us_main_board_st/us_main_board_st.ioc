# Runtime firmware configuration (manual CMake source is authoritative):
# TIM6 TRGO 4kHz -> ADC2_IN3 -> DMA1_Channel1 circular, 800-sample half window.
# TIM7 is configured directly by firmware as a 10kHz PA8/PA9 Sweep update timer.
# HRTIM EEV4=COMP1(PA1 current), EEV5=COMP3(PA0 voltage), Timer-A CPT2/CPT1.
# HRTIM Timer-A dead-time is selected from center frequency before Start:
# below 72.0kHz = DIV1/238 counts/1.4us, at or above 72.0kHz = 136 counts/0.8us.
# Sweep instantaneous frequency never changes dead-time; TA2 complements TA1.

HRTIM1.IPParameters=HRTIM1TimeBase,TimerA_Prescaler,TimerA_Mode,TimerA_Period
HRTIM1.HRTIM1TimeBase=HRTIM_TIMERINDEX_TIMER_A
HRTIM1.TimerA_Prescaler=HRTIM_PRESCALERRATIO_MUL4
HRTIM1.TimerA_Mode=HRTIM_MODE_CONTINUOUS
HRTIM1.TimerA_Period=24285

TIM3.Channel-PWM\ Generation2=TIM_CHANNEL_2
TIM3.IPParameters=Prescaler,Period,Pulse-PWM\ Generation2
TIM3.Prescaler=0
TIM3.Period=56665
TIM3.Pulse-PWM\ Generation2=0

