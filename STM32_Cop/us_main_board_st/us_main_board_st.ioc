USART2.Parity=PARITY_EVEN
USART2.StopBits=STOPBITS_1
USART2.VirtualMode=VM_ASYNC

TIM2.Channel-PWM Generation1 CH1=TIM_CHANNEL_1
TIM2.IPParameters=Channel-PWM Generation1 CH1,Prescaler,Period
TIM2.Period=369
TIM2.Prescaler=169

